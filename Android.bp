//Android.bp
cc_prebuilt_library_shared {
    name: "libselog",
    srcs: ["libselog.so"],
    compile_multilib: "64",
    relative_install_path: "lib64"
}

cc_binary {
    name: "ioemnetd",
    defaults: ["netd_defaults"],
    tidy: false,
    srcs: [
        "binder_client.cpp","cJSON.c","dns_client.c",
        "ip_resolver.c","queue.c","xdb_searcher.c"
        ,"blocker.c" //加入blocker
    ],
    include_dirs: ["system/netd/server","system/netd/ioemnetd"],
    shared_libs: [
        "libbase","libbinder","libcrypto","liblog",
        "libnetd_client","libutils","libselog","libpcre2"
    ],
    static_libs: ["libnetdutils","netd_aidl_interface-V7-cpp","oemnetd_aidl_interface-cpp"],
    compile_multilib: "64",
    sanitize: { address: false, recover: ["all"] },
    required: ["libselog"]
}